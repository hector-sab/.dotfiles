# Renames a tmux pane custom title name
#
# To execute this command, make sure to be inside a
# tmux session.
# $ ./tmux-rename-pane new-name [pane_id]
#
# To remove the name execute the it without any
# argument.
# $ ./tmux-rename-pane
# $ ./tmux-rename-pane "" 4

if ! command -v tmux &> /dev/null
then
    # https://stackoverflow.com/a/23550347
    >&2 echo "tmux is not available"
    exit 1
fi

NEW_NAME="$1"
PANE_ID="${2:-$(tmux display-message -p '#{pane_id}')}"

tmux set-option -t "$PANE_ID" -p @custom_pane_title "$NEW_NAME"
